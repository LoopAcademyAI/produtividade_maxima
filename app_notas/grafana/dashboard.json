{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pedidos por minuto",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"entrelinhas\"} | json | event=\"pedido_concluido\" [1m]))",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Erros por minuto",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"entrelinhas\"} | json | nivel=\"error\" [1m]))",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Eventos da aplicação",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"entrelinhas\"} | json",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência do modelo — p50 / p95",
      "description": "Percentis móveis de 1 hora por chamada ao modelo, incluindo chamadas que falharam. A duração não inclui o envio para Loki.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.50, {service_name=\"entrelinhas\", environment=\"production\"} | json | event=\"chamada_modelo\" | unwrap duracao_ms | __error__=\"\" [1h])",
          "legendFormat": "p50",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {service_name=\"entrelinhas\", environment=\"production\"} | json | event=\"chamada_modelo\" | unwrap duracao_ms | __error__=\"\" [1h])",
          "legendFormat": "p95",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens por hora — entrada / saída",
      "description": "Soma móvel de 1 hora. Chamadas sem contagem de tokens devolvida pelo fornecedor ficam fora da soma.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time({service_name=\"entrelinhas\", environment=\"production\"} | json | event=\"chamada_modelo\" | unwrap tokens_entrada | __error__=\"\" [1h]))",
          "legendFormat": "Entrada",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(sum_over_time({service_name=\"entrelinhas\", environment=\"production\"} | json | event=\"chamada_modelo\" | unwrap tokens_saida | __error__=\"\" [1h]))",
          "legendFormat": "Saída",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "entrelinhas",
    "logs",
    "metricas-modelo"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Entrelinhas — Observabilidade",
  "version": 2
}
