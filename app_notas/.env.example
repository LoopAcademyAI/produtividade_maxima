# Copia para .env apenas no teu computador. Nunca envies este ficheiro preenchido.
# A aplicação também lê variáveis de ambiente configuradas na Vercel.

# Obrigatória para classificar notas através da NVIDIA NIM.
NVIDIA_API_KEY=

# Obrigatória para o servidor MCP (/mcp): uma chave por tester, em JSON {"nome": "chave"}.
# Sem isto, /mcp rejeita todos os pedidos. Chaves com menos de 24 caracteres são ignoradas.
# Gerar uma chave: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Exemplo: MCP_TESTERS='{"ana": "chave-da-ana", "rui": "chave-do-rui"}'
MCP_TESTERS=

# Obrigatórias para o log de chamadas MCP (tester, categoria, hora) na Upstash Redis.
# Consola Upstash → base de dados → secção REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcionais: só necessários para enviar eventos técnicos para Grafana Cloud Loki.
# Cria estes valores no teu próprio stack Grafana e configura-os como Secrets na Vercel.
LOKI_PUSH_URL=
LOKI_USER=
LOKI_TOKEN=
